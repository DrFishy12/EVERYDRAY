{
  "name": "everydray-ai-proxy",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker that connects the EVERYDRAY site chat to Claude",
  "scripts": {
    "build": "esbuild worker.js --bundle --format=esm --platform=browser --conditions=workerd,worker,browser --target=es2022 --minify --legal-comments=eof --outfile=dist/worker.js",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.14.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "wrangler": "4"
  }
}
